APP_NAME=Xynasoft Xynapse
ENV=local
DATABASE_URL=postgresql+psycopg2://xynapse:xynapse@localhost:5432/xynapse
AUTH_ENABLED=true
API_KEY=change-me

# =========================================
# XynAssist Integration
# =========================================
